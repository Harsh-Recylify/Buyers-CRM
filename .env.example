# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# PostgreSQL connection string (any Postgres 14+ works)
# Example: postgresql://user:password@localhost:5432/recyclify
DATABASE_URL=

# Secret used to sign JWT auth tokens — set any long random string
SESSION_SECRET=

# Allowed origins for CORS, comma-separated (e.g. http://localhost:3000)
# Leave blank or omit to allow all origins in development
CORS_ORIGIN=

# --- Per-service variables (set when starting each service) ---
# API server port (routes are served under /api)
# PORT=8080

# Frontend dev server (Vite) — required by vite.config.ts
# PORT=3000
# BASE_PATH=/
